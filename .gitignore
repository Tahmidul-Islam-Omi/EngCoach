# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/

# Secrets and local configuration — never commit these.
# Document required keys in .env.example instead (committed, dummy values only).
.env
.env.*
!.env.example
secrets.dart
lib/**/*_secrets.dart

# Server-side credentials. These are true secrets, unlike the Firebase client
# config files (google-services.json / firebase_options.dart), which are safe
# to commit and are needed for the build to succeed on a fresh clone.
*-service-account*.json
service-account*.json
serviceAccountKey*.json
*.pem
*.p12
*.p8

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Device screenshots — scratch, not part of the project.
screenshots/

# Claude Code / AI assistant tooling — local to this machine.
.claude/
CLAUDE.md
.gemini/
.mcp.json
.aider*
.cursor/
.windsurfrules
.github/copilot-instructions.md
